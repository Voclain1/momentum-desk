# Copy to deploy/.env on the server (never commit it) and fill in.
# docker compose reads this file; each value is described in docs/go-live.md.

# Public host name; Caddy gets its TLS certificate for it.
DOMAIN=momentumdesk.app

# Database passwords. Letters and digits only (they go into connection URLs):
#   openssl rand -hex 24
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# openssl rand -base64 32 (each a different value)
BETTER_AUTH_SECRET=
PROVIDER_SECRETS_KEY=

# Email through Resend (D17): both or neither.
RESEND_API_KEY=
EMAIL_FROM=MomentumDesk <no-reply@momentumdesk.app>

# Momentum AI (D20), optional: "anthropic" or "openai" plus that provider's key.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default claude-opus-5-5 for Anthropic; required for OpenAI.
AI_MODEL=
AI_MONTHLY_LIMIT=200

# Optional
FX_PROVIDER_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Optional, build time only: readable stack traces in Sentry. SENTRY_AUTH_TOKEN
# is a secret: export it in the shell for `docker compose build`, not here.
SENTRY_ORG=
SENTRY_PROJECT=

# Copy to .env.local and fill in. Every variable is validated in lib/env.ts.
# Next.js and the Prisma CLI (prisma.config.ts) both read .env.local.

# Public origin of the app. Used in emailed sign-in and reset links; set it in
# production. Vercel previews fall back to the deployment URL.
APP_URL=http://localhost:3000

# Signs session cookies and tokens (required, 32+ characters). Generate with:
#   openssl rand -base64 32
# Use a different value in each environment.
BETTER_AUTH_SECRET=

# PostgreSQL connection string (required). In production and previews use the
# Neon pooled connection string for this branch.
DATABASE_URL=postgresql://postgres@localhost:5432/momentum_dev

# Separate database for `pnpm test:db`. Tests empty it, so its name must end
# in "_test".
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/momentum_test

# Optional: path to an already-installed Chromium for `pnpm test:e2e`.
# Leave unset to use the browser from `pnpm exec playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_PATH=

# Copy to .env.local and fill in. Every variable is validated in lib/env.ts.
# Next.js and the Prisma CLI (prisma.config.ts) both read .env.local.

# Public origin of the app. Used in emailed sign-in and reset links; set it in
# production. Vercel previews fall back to the deployment URL.
APP_URL=http://localhost:3000

# Signs session cookies and tokens (required, 32+ characters). Generate with:
#   openssl rand -base64 32
# Use a different value in each environment.
BETTER_AUTH_SECRET=

# PostgreSQL connection for the app (required), as the restricted app role
# that cannot bypass row-level security (docs/tenant-isolation.md). In
# production and previews use the Neon pooled connection string.
DATABASE_URL=postgresql://momentum_app:app@localhost:5432/momentum_dev

# Owner connection used only by `prisma migrate` (falls back to DATABASE_URL).
MIGRATION_DATABASE_URL=postgresql://postgres@localhost:5432/momentum_dev

# Separate database for `pnpm test:db` and `pnpm test:e2e`. Tests empty it, so
# its name must end in "_test". Same role split as above.
TEST_DATABASE_URL=postgresql://momentum_app:app@localhost:5432/momentum_test
TEST_MIGRATION_DATABASE_URL=postgresql://postgres@localhost:5432/momentum_test

# Optional: path to an already-installed Chromium for `pnpm test:e2e`.
# Leave unset to use the browser from `pnpm exec playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_PATH=

// MomentumDesk database schema.
//
// User, Session, Account, Verification, Organization, Member and Invitation
// follow the shape Better Auth 1.7 (with the organization plugin) expects, so
// authentication can use these tables without renaming. Organization carries
// the global settings from docs/product-spec.md §5.1 as extra columns.
//
// Database-level CHECK constraints (currency, country and role formats) live
// in the migration SQL because Prisma's schema language cannot express them.
// After changing this file run `pnpm db:migrate` to create a migration.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions         Session[]
  accounts         Account[]
  memberships      Member[]
  invitations      Invitation[] @relation("InvitationInviter")
  auditLogs        AuditLog[]
  customersCreated Customer[]   @relation("CustomerCreatedBy")
  leadsOwned       Lead[]       @relation("LeadOwner")
  leadsCreated     Lead[]       @relation("LeadCreatedBy")
  activities       Activity[]   @relation("ActivityAuthor")
  tasksAssigned    Task[]       @relation("TaskAssignee")
  tasksCreated     Task[]       @relation("TaskCreatedBy")
  tasksCompleted   Task[]       @relation("TaskCompletedBy")

  @@map("user")
}

model Session {
  id                   String   @id
  token                String   @unique
  expiresAt            DateTime @db.Timestamptz(3)
  ipAddress            String?
  userAgent            String?
  userId               String
  /// The organization the user is currently working in. Never trusted on its
  /// own: membership is re-checked server-side on every request.
  activeOrganizationId String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Password hash for email/password sign-in. Never a plaintext password.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// A tenant. Every business record belongs to exactly one organization.
model Organization {
  id        String    @id
  name      String
  slug      String    @unique
  logo      String?
  metadata  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  // Global settings (spec §5.1). None is inferred from another: a company can
  // be in one country, report in another currency and invoice in several.
  /// ISO 4217 reporting currency, e.g. "USD". Must be in lib/money/currencies.ts.
  /// Fixed once the workspace exists (database trigger): changing it would
  /// silently change the meaning of every historical report (spec §5.4).
  baseCurrency           String
  /// ISO 3166-1 alpha-2 country code, e.g. "NG".
  countryCode            String
  /// BCP 47 locale for formatting, e.g. "en-GB".
  locale                 String
  /// IANA timezone, e.g. "Europe/London".
  timezone               String
  /// BCP 47 language for the interface and customer documents, e.g. "en".
  defaultLanguage        String
  /// Optional ISO 4217 default for new quotes and invoices.
  defaultInvoiceCurrency String?
  /// Incremented on every settings change. Saves must name the version they
  /// were based on, so concurrent edits cannot silently overwrite each other.
  settingsVersion        Int     @default(1)

  members     Member[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  customers   Customer[]
  contacts    Contact[]
  stages      PipelineStage[]
  leads       Lead[]
  activities  Activity[]
  tasks       Task[]

  @@map("organization")
}

/// A user's membership of an organization. One row per (organization, user).
model Member {
  id             String   @id
  organizationId String
  userId         String
  /// One of the roles in docs/product-spec.md §10 (owner, admin, sales,
  /// finance, member). Permissions are resolved from it server-side.
  role           String   @default("member")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String    @id
  organizationId String
  email          String
  role           String
  /// "pending", "accepted", "rejected" or "canceled".
  status         String    @default("pending")
  expiresAt      DateTime? @db.Timestamptz(3)
  inviterId      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Request counters for Better Auth's rate limiter. Stored in the database
/// because in-memory counters are per instance on serverless hosting.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  /// Milliseconds since the Unix epoch.
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Organization-owned data. Every model below has an organizationId, is listed
// in lib/tenant/models.ts, is read and written only through tenantDb(), and
// has row-level security in its migration. See docs/tenant-isolation.md.
// ---------------------------------------------------------------------------

/// Append-only record of significant actions in a workspace (spec §10, §12).
/// The database rejects UPDATE and DELETE except as a side effect of deleting
/// the organization or the acting user.
model AuditLog {
  id             String   @id @default(uuid(7))
  organizationId String
  /// Null for system actions, or after the acting user's account is deleted.
  actorUserId    String?
  /// Dotted verb, e.g. "organization.settings_updated". See lib/audit.
  action         String
  targetType     String?
  targetId       String?
  /// Action details. Never secrets or full documents.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("auditLog")
}

/// A business's customer: a person or an organization (spec §7.3). Master
/// data only: quotes and invoices will snapshot what they need at issue time,
/// so later edits here never change an issued document.
model Customer {
  id                String    @id @default(uuid(7))
  organizationId    String
  /// "person" or "organization".
  type              String
  /// The name used across the app, e.g. "Acme Solar".
  displayName       String
  /// Registered legal name, for invoices, when it differs.
  legalName         String?
  /// Stored lower-case.
  email             String?
  phone             String?
  website           String?
  /// VAT, TIN or similar, as the customer's tax authority writes it.
  taxId             String?
  /// ISO 3166-1 alpha-2. Never used to infer currency or language.
  countryCode       String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
  postalCode        String?
  /// BCP 47, for documents and reminders sent to this customer.
  preferredLocale   String?
  preferredLanguage String?
  /// ISO 4217. A default for new documents only; never overrides an
  /// existing document's currency (spec §5.2).
  preferredCurrency String?
  tags              String[]  @default([])
  notes             String?
  /// Archived customers are hidden from lists but keep their history.
  archivedAt        DateTime? @db.Timestamptz(3)
  createdById       String?
  /// Incremented on every edit; saves must name the version they started from.
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts     Contact[]
  activities   Activity[]
  tasks        Task[]
  leads        Lead[]

  /// Lets child tables reference (id, organizationId), so a child row can
  /// never point at another organization's customer.
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, displayName])
  @@index([organizationId, updatedAt])
  @@map("customer")
}

/// A person at a customer: who to address quotes, invoices and reminders to.
model Contact {
  id             String   @id @default(uuid(7))
  organizationId String
  customerId     String
  name           String
  /// Stored lower-case.
  email          String?
  phone          String?
  jobTitle       String?
  /// At most one primary contact per customer (partial unique index).
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: the contact's organization must be its customer's.
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("contact")
}

/// A stage of the workspace's sales pipeline (spec §7.2). One pipeline per
/// workspace in V1. Logic depends on `kind`, never on the stage name, so
/// stages can be renamed or added later.
model PipelineStage {
  id             String   @id @default(uuid(7))
  organizationId String
  /// Stable identifier for the default stages, e.g. "qualified".
  key            String
  name           String
  /// "open", "won" or "lost".
  kind           String
  /// Order on the board, lowest first.
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([id, organizationId])
  @@unique([organizationId, key])
  @@index([organizationId, position])
  @@map("pipelineStage")
}

/// An enquiry or deal moving through the pipeline, from first contact to won
/// or lost (spec §7.2).
model Lead {
  id                  String    @id @default(uuid(7))
  organizationId      String
  /// The person enquiring. At least one of contactName and companyName.
  contactName         String?
  companyName         String?
  /// Stored lower-case.
  email               String?
  phone               String?
  /// Where the lead came from, e.g. "referral". See lib/leads/schema.ts.
  source              String?
  /// Workspace member responsible for the lead.
  ownerUserId         String?
  stageId             String
  /// Estimated value in minor units of `currency` (spec §5.3). Both or neither.
  estimatedValueMinor BigInt?
  currency            String?
  /// What the customer needs.
  summary             String?
  /// Calendar date in the workspace's timezone.
  nextFollowUpOn      DateTime? @db.Date
  tags                String[]  @default([])
  notes               String?
  /// When the lead entered its current stage.
  stageChangedAt      DateTime  @default(now()) @db.Timestamptz(3)
  /// Set when the lead reaches a won or lost stage; cleared if reopened.
  closedAt            DateTime? @db.Timestamptz(3)
  lostReason          String?
  /// The customer this lead became or belongs to (spec §7.2 conversion).
  /// The lead and its history stay; only the link is added.
  customerId          String?
  convertedAt         DateTime? @db.Timestamptz(3)
  archivedAt          DateTime? @db.Timestamptz(3)
  createdById         String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: a lead's stage must belong to its own workspace.
  stage        PipelineStage @relation(fields: [stageId, organizationId], references: [id, organizationId], onDelete: NoAction)
  owner        User?         @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Composite key: the linked customer must be in the same workspace.
  customer     Customer?     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  activities   Activity[]
  tasks        Task[]

  /// Lets activities and tasks reference (id, organizationId).
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, stageId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, nextFollowUpOn])
  @@index([organizationId, updatedAt])
  @@index([organizationId, customerId])
  @@map("lead")
}

/// Something said or done with a lead or customer: a note, or a logged call,
/// email, meeting or message (spec §7.2). The record's own history (created,
/// stage moves, edits) comes from the audit log and is merged into the
/// timeline, not stored twice.
model Activity {
  id             String    @id @default(uuid(7))
  organizationId String
  /// "note", "call", "email", "meeting" or "message".
  kind           String
  body           String
  /// When it happened (a call yesterday can be logged today).
  occurredAt     DateTime  @db.Timestamptz(3)
  /// Exactly one of leadId and customerId.
  leadId         String?
  customerId     String?
  authorUserId   String?
  editedAt       DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author       User?        @relation("ActivityAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, customerId, occurredAt])
  @@map("activity")
}

/// A to-do, optionally about one lead or customer (spec §7.2 "tasks and
/// reminders"). Reminders are shown in the app; emailed reminders wait for
/// the background job service (D18).
model Task {
  id             String    @id @default(uuid(7))
  organizationId String
  title          String
  notes          String?
  /// Calendar date in the workspace's timezone.
  dueOn          DateTime? @db.Date
  assigneeUserId String?
  /// At most one of leadId and customerId; neither for a standalone task.
  leadId         String?
  customerId     String?
  completedAt    DateTime? @db.Timestamptz(3)
  completedById  String?
  createdById    String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy  User?        @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([organizationId, completedAt, dueOn])
  @@index([organizationId, assigneeUserId, completedAt])
  @@index([organizationId, leadId])
  @@index([organizationId, customerId])
  @@map("task")
}
